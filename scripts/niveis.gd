class_name Niveis
extends RefCounted

# Dados das 5 fases: cenário, força dos inimigos e mapa.
#
# A dificuldade sobe a cada fase:
#  1 Floresta Ensolarada   - 1 chave. Gambás lentos (1 de vida). Buracos pequenos.
#  2 Pântano ao Entardecer - 2 chaves. Sapos saltadores, plataformas móveis sobre a água.
#  3 Caverna Sombria       - 3 chaves. Escuro, morcegos, espinhos, escadas, inimigos com 2 de vida.
#  4 Ruínas Celestes       - 3 chaves. Ilhas no céu, águias que mergulham, plataformas que caem.
#  5 Fortaleza Vulcânica   - 4 chaves. Lava, todos os inimigos no máximo e o chefe Gambá Gigante.
#
# Cada mapa é dividido em "segmentos" (pedaços colocados lado a lado) para ficar
# fácil de ler e editar. A legenda dos caracteres está em construtor_fase.gd.

static func obter(id: int) -> Dictionary:
	match id:
		1: return FASE_1
		2: return FASE_2
		3: return FASE_3
		4: return FASE_4
		5: return FASE_5
	return FASE_1

